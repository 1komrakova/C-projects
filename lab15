#include <stdio.h>

void print_forward(int n) {
    if (n < 10) {
        printf("%d ", n);
        return;
    }
    print_forward(n / 10);
    printf("%d ", n % 10);
}

void print_backward(int n) {
    if (n < 10) {
        printf("%d ", n);
        return;
    }
    printf("%d ", n % 10);
    print_backward(n / 10);
}

int main() {
    int n;
    printf("enter: ");
    scanf("%d", &n);
    print_forward(n);
	printf("\n");
    print_backward(n);

    return 0;
}
